BasedOnStyle: Google

# Forbid: if (a) { return; }
AllowShortBlocksOnASingleLine: Never

# Forbid: void f() { return; }
AllowShortFunctionsOnASingleLine: None

# Forbid: if (a) return; (without braces)
AllowShortIfStatementsOnASingleLine: Never

# Force braces on every if/else/for/while/do, even a single-statement body
# spread across two lines (if (a)\n  return;)
InsertBraces: true

# Forbid: while (true) { continue; }
AllowShortLoopsOnASingleLine: false

# Forbid: switch (a) { case 1: return; }
AllowShortCaseLabelsOnASingleLine: false

BreakBeforeBraces: Allman
